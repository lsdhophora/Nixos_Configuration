{
  "version": 1,
  "servers": [
    {
      "id": "clangd",
      "enabled": true,
      "include": ["**/*.c", "**/*.h", "**/*.cpp", "**/*.hpp", "**/*.cc", "**/*.cxx"],
      "rootMarkers": ["compile_commands.json", ".clangd", "CMakeLists.txt", "Makefile"],
      "bin": "clangd",
      "args": ["--background-index"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".c": "c",
        ".h": "c",
        ".cpp": "cpp",
        ".hpp": "cpp",
        ".cc": "cpp",
        ".cxx": "cpp"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "nixd",
      "enabled": true,
      "include": ["**/*.nix"],
      "rootMarkers": ["flake.nix", "default.nix", "shell.nix", "nixd.json"],
      "bin": "nixd",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": { ".nix": "nix" },
      "startupTimeoutMs": 30000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "texlab",
      "enabled": true,
      "include": ["**/*.tex", "**/*.bib"],
      "rootMarkers": [".latexmkrc", "latexmkrc", ".texliveonfly", "Makefile"],
      "bin": "texlab",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": { ".tex": "latex", ".bib": "bibtex" },
      "startupTimeoutMs": 30000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    }
  ]
}
