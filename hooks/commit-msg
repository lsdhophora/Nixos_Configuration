#!/usr/bin/env sh
# commit-msg hook: require a Reviewed-by trailer from an approved reviewer.
#
# A commit is allowed only when the message carries a trailer such as
#   Reviewed-by: lsdhophora        (human review attestation)
#   Reviewed-by: ai                (AI self-review: skips the human gate)
# The trailer stays in history, so every commit is auditable with
#   git log --format=%b | grep Reviewed-by
#
# Merge commits are exempt: their content is already reviewed at the
# source commits, and the generated merge message carries no trailer.
#
# The git commit-msg hook receives the message file with the comment
# block and (with verbose output) the diff below the cut line.  Only
# inspect the message region: everything before the first comment
# line, so a diff line that happens to look like a trailer cannot
# satisfy the check.

set -u

msg_file="$1"
allowed_reviewers="lsdhophora ai"

# Print the message region: lines up to the first line that starts
# with '#' (the git comment block / cut line).
msg=$(sed -n '/^#/q;p' "$msg_file")

summary=$(printf '%s\n' "$msg" | sed -n '1p')

case "$summary" in
  "Merge "*) exit 0 ;;
esac

reviewer=$(printf '%s\n' "$msg" \
  | sed -n 's/^Reviewed-by: *\([^<]*\).*/\1/p' \
  | tail -n 1 \
  | sed 's/[[:space:]]*$//')

if [ -z "$reviewer" ]; then
  echo "Commit rejected: no Reviewed-by trailer" >&2
  echo "Please review the changes, then end the message with:" >&2
  echo "  Reviewed-by: lsdhophora" >&2
  echo "(or Reviewed-by: ai to skip the human review)" >&2
  exit 1
fi

case " $allowed_reviewers " in
  *" $reviewer "*) exit 0 ;;
esac

echo "Commit rejected: reviewer '$reviewer' is not in the whitelist" >&2
echo "Whitelisted reviewers: $allowed_reviewers" >&2
exit 1
