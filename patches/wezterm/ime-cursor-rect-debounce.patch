     fn set_text_cursor_position(&mut self, rect: Rect) {
+        if self.text_cursor.map(|prior| prior != rect).unwrap_or(true) {
+            self.pending_text_cursor = Some(rect);
+            self.text_cursor_stable_since = Some(Instant::now());
+            let window_id = SurfaceUserData::from_wl(self.surface()).window_id;
+            let target = rect;
+            promise::spawn::spawn_into_main_thread(async move {
+                let wait = {
+                    let conn = WaylandConnection::get().unwrap().wayland();
+                    let handle = match conn.window_by_id(window_id) {
+                        Some(handle) => handle,
+                        None => return,
+                    };
+                    let inner = handle.borrow();
+                    match inner.text_cursor_stable_since {
+                        Some(since) => {
+                            let elapsed = since.elapsed();
+                            if elapsed < TEXT_CURSOR_DEBOUNCE {
+                                TEXT_CURSOR_DEBOUNCE - elapsed
+                            } else {
+                                Duration::ZERO
+                            }
+                        }
+                        None => Duration::ZERO,
+                    }
+                };
+                if !wait.is_zero() {
+                    Timer::after(wait).await;
+                }
+                let conn = WaylandConnection::get().unwrap().wayland();
+                if let Some(handle) = conn.window_by_id(window_id) {
+                    let mut inner = handle.borrow_mut();
+                    // A newer position resets the timer; commit only if the
+                    // pending position is still the one we waited for.
+                    if inner.pending_text_cursor == Some(target)
+                        && inner.text_cursor != Some(target)
+                    {
+                        inner.commit_text_cursor(target);
+                    }
+                }
+            })
+            .detach();
+        }
+    }
