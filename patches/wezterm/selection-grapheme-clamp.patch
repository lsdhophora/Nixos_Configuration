+/// Clamp a cell range so that its boundaries do not split a wide
+/// (multi-cell) grapheme cluster in half.
+///
+/// The terminal screen buffer is a grid of cells; a wide character (for
+/// example a CJK ideograph or an emoji) occupies two cells: a leading cell
+/// that holds the text and a trailing continuation cell. The mouse can
+/// position a selection boundary between the two halves of such a
+/// character, which makes it possible to visually select only half of it.
+///
+/// This mirrors kitty's `xrange_for_iteration_with_multicells`: a boundary
+/// that falls inside a wide character is expanded to cover the entire
+/// character. It must be applied wherever a selection range is turned into
+/// concrete cells (rendering the selection highlight and extracting the
+/// selected text) so that both agree.
+pub fn clamp_range_to_graphemes(line: &Line, range: Range<usize>) -> Range<usize> {
+    if range.start >= range.end {
+        return range;
+    }
+    let mut start = range.start;
+    let mut end = range.end;
+    // If the start boundary falls on the continuation cell of a wide
+    // character, back up to the leading cell so the whole character is
+    // included.
+    if start > 0 && line.get_cell(start - 1).map_or(false, |c| c.width() > 1) {
+        start -= 1;
+    }
+    // If the end boundary falls right after the leading cell of a wide
+    // character, extend it past the continuation cell.
+    if end > 0 && line.get_cell(end - 1).map_or(false, |c| c.width() > 1) {
+        end = end.saturating_add(1).min(line.len());
+    }
+    start..end
+}
