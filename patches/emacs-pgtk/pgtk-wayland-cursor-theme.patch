Read the cursor theme and size via GtkSettings and push them to GDK on Wayland

GDK's Wayland backend falls back to a hard-coded 24px cursor theme
when its settings channel lacks "gtk-cursor-theme-size".  GtkSettings
already resolves the values kde-gtk-config mirrors from the Plasma
cursor settings; read them with the GTK API (gtk_settings_get_default)
and push them down to GDK before any frame cursor is created.
Without this, the pointer inside Emacs buffers is smaller than the
system cursor under KDE Plasma Wayland.

--- a/src/pgtkterm.c
+++ b/src/pgtkterm.c
@@ -7146,6 +7146,28 @@
   dpyinfo->name_list_element = Fcons (lisp_dpy_name, Qnil);
   dpyinfo->gdpy = dpy;
 
+#ifdef GDK_WINDOWING_WAYLAND
+  if (GDK_IS_WAYLAND_DISPLAY (dpy))
+    {
+      /* GDK's Wayland backend falls back to a hard-coded 24px cursor
+	 theme when its settings channel lacks "gtk-cursor-theme-size".
+	 GtkSettings already carries the values kde-gtk-config mirrors
+	 from the Plasma cursor settings; read them through the GTK API
+	 and push them down to GDK before any frame cursor is created.  */
+      gint size = 0;
+      gchar *theme = NULL;
+
+      g_object_get (gtk_settings_get_default (),
+		    "gtk-cursor-theme-size", &size,
+		    "gtk-cursor-theme-name", &theme,
+		    NULL);
+      if (theme && size > 0)
+	gdk_wayland_display_set_cursor_theme (dpy, theme, size);
+      g_free (theme);
+    }
+#endif
+
+
   /* https://lists.gnu.org/r/emacs-devel/2015-11/msg00194.html  */
   dpyinfo->smallest_font_height = 1;
   dpyinfo->smallest_char_width = 1;
