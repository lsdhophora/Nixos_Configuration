+void Job::openFolder(const QUrl &url)
+{
+    qDebug() << "Job::openFolder called, url:" << url << "valid:" << url.isValid() << "empty:" << url.isEmpty();
+    if (url.isValid() && !url.isEmpty()) {
+        const bool ok = QProcess::startDetached(QStringLiteral("kioclient"), {QStringLiteral("exec"), url.toString()});
+        qDebug() << "Job::openFolder: QProcess::startDetached returned:" << ok;
+    } else {
+        qDebug() << "Job::openFolder: url invalid or empty, skipping";
+    }
+}
