+    //
+    // The shell only reports its current directory asynchronously, once it has actually
+    // processed the "cd" commands that we sent (via an OSC 7 sequence in the prompt, which
+    // Konsole additionally debounces with a short timer). When the view navigates quickly,
+    // several "cd" commands can be in flight at once, and the reports can arrive out of
+    // order, be collapsed, or carry the previous directory. Only consume queue entries that
+    // match the reported directory: a stale report for the previous directory must not
+    // discard the pending commands, otherwise the whole queue would be drained and the view
+    // yanked back to the terminal's old location, only to jump to the target again once the
+    // shell catches up.
+    const int matchIndex = m_sendCdToTerminalHistory.indexOf(m_konsolePartCurrentDirectory);
+    if (matchIndex != -1) {
+        // The terminal has caught up with a change that we triggered. Drop the matching
+        // entry and everything before it: the terminal may have processed several commands
+        // back-to-back and skipped the reports in between.
+        for (int i = 0; i <= matchIndex; ++i) {
+            m_sendCdToTerminalHistory.dequeue();
         }
+        return;
+    }
+    if (!m_sendCdToTerminalHistory.isEmpty()) {
+        // "cd" commands are still in flight, but the report matches none of them, so it
+        // cannot have been caused by a user action inside the terminal. Ignore it instead
+        // of following the terminal to a location that the shell is about to leave again.
+        return;
     }
 
