# The client main loop checked the quit flag only at the top of the loop. A
# SIGHUP that arrives while a stdin read is pending sets the flag, but the
# resumed read still returns the bytes the host terminal wrote during
# shutdown (WezTerm writes LF and EOT when it closes a pane). The client
# forwarded them and typed a newline or EOF into the focused pane.
--- a/src/client/mod.rs
+++ b/src/client/mod.rs
@@ -720,6 +720,15 @@
             ClientLoopEvent::EndpointCatalog(reload) => pending_catalog = Some(reload),
             #[cfg(unix)]
             ClientLoopEvent::StdinInput(data) => {
+                // A termination signal (SIGHUP from a host terminal that closed
+                // its window) can arrive while a stdin read is in flight. That
+                // read then returns the bytes the host terminal wrote during
+                // shutdown: WezTerm writes LF and EOT to the pane when it closes
+                // a window. Forwarding them types a newline or EOF into the
+                // focused pane, so drop input once the quit flag is set.
+                if should_quit.load(Ordering::Acquire) {
+                    continue;
+                }
                 let image_bridge_active = endpoint_accepts_local_images(
                     is_remote_client,
                     write_stream.active_id(),