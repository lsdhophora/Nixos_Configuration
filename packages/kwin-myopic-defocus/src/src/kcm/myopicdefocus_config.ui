    <widget class="QLabel" name="descriptionLabel">
     <property name="text">
      <string>Blurs the green and blue color channels of the whole screen while keeping red sharp, simulating myopic chromatic defocus ("red in focus"). See the paper by Swiatczak et al. (2024), doi:10.15626/sjovs.v17i2.4232.</string>
     </property>
